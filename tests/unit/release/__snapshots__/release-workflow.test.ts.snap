// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`release.yml safety-critical steps match the reviewed snapshot > manifest: Write manifest.json and SHA256SUMS 1`] = `
{
  "env": {
    "TAG": "\${{ needs.verify.outputs.tag }}",
    "VERSION": "\${{ needs.verify.outputs.version }}",
  },
  "run": "npx ts-node scripts/release/release-manifest.ts \\
  --tag "$TAG" --version "$VERSION" --commit "$GITHUB_SHA" \\
  --windows-dir build/windows --linux-dir build/linux \\
  --out-dir release-bundle
",
  "uses": undefined,
  "with": undefined,
}
`;

exports[`release.yml safety-critical steps match the reviewed snapshot > publish: Check no draft exists for this version 1`] = `
{
  "env": {
    "GH_TOKEN": "\${{ github.token }}",
    "TAG": "\${{ needs.verify.outputs.tag }}",
  },
  "run": "existing=$(gh api --paginate "repos/$GITHUB_REPOSITORY/releases" \\
  --jq ".[] | select(.tag_name == \\"$TAG\\") | .html_url")
if [[ -n "$existing" ]]; then
  echo "::error::A release or draft for $TAG already exists: $existing. If it's a draft marked INCOMPLETE, or it's missing any file listed in its SHA256SUMS or manifest.json, delete it and run this workflow again. Publish it only if it's complete and built from the commit you want (see its manifest.json)."
  exit 1
fi
",
  "uses": undefined,
  "with": undefined,
}
`;

exports[`release.yml safety-critical steps match the reviewed snapshot > publish: Create draft GitHub Release 1`] = `
{
  "env": {
    "GH_TOKEN": "\${{ github.token }}",
    "PRERELEASE": "\${{ needs.verify.outputs.prerelease }}",
    "TAG": "\${{ needs.verify.outputs.tag }}",
  },
  "run": "failed=""
stalled=""
upload_status=0
# A normal upload takes 1-3 minutes; give up after 10 so a stall
# is reported here instead of by the job's own timeout.
timeout 10m gh release create "$TAG" release-bundle/* \\
  --repo "$GITHUB_REPOSITORY" \\
  --draft \\
  --target "$GITHUB_SHA" \\
  --title "Bloom Desktop $TAG" \\
  --generate-notes \\
  --prerelease="$PRERELEASE" || upload_status=$?
if [[ "$upload_status" == 124 ]]; then
  failed="the upload timed out after 10 minutes"
  stalled=1
elif [[ "$upload_status" != 0 ]]; then
  failed="the upload failed"
fi
# A just-created draft can take a moment to appear in the list, and
# the call itself can fail, so look it up a few times.
release_id=""
for attempt in 1 2 3; do
  release_id=$(gh api --paginate "repos/$GITHUB_REPOSITORY/releases" \\
    --jq ".[] | select(.tag_name == \\"$TAG\\" and .draft) | .id" || true)
  [[ -n "$release_id" ]] && break
  [[ "$attempt" -lt 3 ]] && sleep 5
done
if [[ -z "$failed" && -z "$release_id" ]]; then
  failed="the draft wasn't found after creating it"
fi
if [[ -z "$failed" ]]; then
  if ! attached=$(gh api --paginate "repos/$GITHUB_REPOSITORY/releases/$release_id/assets" --jq '.[].name'); then
    failed="the draft's files couldn't be listed"
  elif [[ "$(sort <<< "$attached")" != "$(ls release-bundle | sort)" ]]; then
    failed="the draft doesn't have exactly the bundle's files (attached: $(echo $attached))"
  fi
fi
if [[ -z "$failed" ]]; then
  echo "Draft $TAG created with every file. Review it on the Releases page, then publish."
  exit 0
fi
echo "::error::Creating the draft for $TAG failed: $failed."
if [[ -z "$release_id" ]]; then
  echo "::error::Couldn't find the draft for $TAG to delete it. If a draft for $TAG is on the Releases page, delete it, then use \\"Re-run failed jobs\\"."
elif [[ -n "$stalled" ]]; then
  # Keep a stalled upload's draft so a maintainer can see what was
  # uploaded, renamed so it can't be mistaken for a real release.
  if gh api -X PATCH "repos/$GITHUB_REPOSITORY/releases/$release_id" \\
    -f "name=INCOMPLETE — do not publish: Bloom Desktop $TAG"; then
    echo "::error::The upload timed out after 10 minutes. The partial draft for $TAG was kept and renamed \\"INCOMPLETE — do not publish\\" so you can see what was uploaded. Don't publish it: delete it on the Releases page, then use \\"Re-run failed jobs\\"."
  else
    echo "::error::The upload timed out after 10 minutes and the partial draft for $TAG was kept. Couldn't mark the draft for $TAG as INCOMPLETE. Don't publish it: delete it on the Releases page, then use \\"Re-run failed jobs\\"."
  fi
elif gh api -X DELETE "repos/$GITHUB_REPOSITORY/releases/$release_id"; then
  echo "::error::Deleted the incomplete draft for $TAG. Use \\"Re-run failed jobs\\" to try again."
else
  echo "::error::Couldn't delete the incomplete draft for $TAG. Delete it on the Releases page, then use \\"Re-run failed jobs\\"."
fi
exit 1
",
  "uses": undefined,
  "with": undefined,
}
`;

