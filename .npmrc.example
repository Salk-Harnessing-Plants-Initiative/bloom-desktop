# npm registry for the Bloom packages (@salk-harnessing-plants-initiative/bloom-js, bloom-fs)
#
# They are private packages on GitHub Packages. To install them locally:
# 1. cp .npmrc.example .npmrc   (.npmrc is gitignored)
# 2. Create a GitHub personal access token (classic) with the read:packages scope.
# 3. export NODE_AUTH_TOKEN=<that token> in your shell, then run npm install.
#
# CI doesn't use this file: actions/setup-node writes its own .npmrc and passes the
# workflow's GITHUB_TOKEN.

@salk-harnessing-plants-initiative:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
